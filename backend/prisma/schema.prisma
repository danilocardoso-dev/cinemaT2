// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS (Compatíveis com os types do React)
// ==========================================

enum TipoIngresso {
  inteira
  meia
}

enum StatusPedido {
  PENDENTE
  CONCLUIDO
  CANCELADO
}

enum CargoUsuario {
  ADMIN
  ATENDENTE
  CLIENTE
}

// ==========================================
// MODELOS DO SISTEMA
// ==========================================

/// Catálogo de Filmes
/// Compatível com a interface Filme em src/types/index.ts
model Filme {
  id            Int      @id @default(autoincrement())
  titulo        String
  sinopse       String   @db.Text
  classificacao String // Livre, 10, 12, 14, 16, 18
  duracao       Int // Duração em minutos
  genero        String // Ação, Comédia, Drama, etc.
  datasExibicao String   @map("datas_exibicao") // Ex: "30/07/2026 a 30/08/2026"
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  sessoes Sessao[]

  @@map("filmes")
}

/// Salas do Cinema
/// Compatível com a interface Sala em src/types/index.ts
model Sala {
  id         Int      @id @default(autoincrement())
  numero     Int      @unique
  capacidade Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  sessoes Sessao[]

  @@map("salas")
}

/// Sessões Agendadas
/// Compatível com a interface Sessao em src/types/index.ts
model Sessao {
  id        Int      @id @default(autoincrement())
  filmeId   Int      @map("filme_id")
  salaId    Int      @map("sala_id")
  dataHora  DateTime @map("data_hora") // ISO String compatível com new Date(dataHora)
  precoBase Float    @default(40.0) @map("preco_base")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  filme     Filme      @relation(fields: [filmeId], references: [id], onDelete: Restrict)
  sala      Sala       @relation(fields: [salaId], references: [id], onDelete: Restrict)
  ingressos Ingresso[]

  @@unique([salaId, dataHora])
  @@index([filmeId])
  @@index([salaId])
  @@index([dataHora])
  @@map("sessoes")
}

/// Produtos da Bomboniere
/// Compatível com a interface LancheCombo em src/types/index.ts
model Lanche {
  id            Int      @id @default(autoincrement())
  nome          String
  descricao     String   @db.Text
  valorUnitario Float    @map("valor_unitario") // Float serializa como number (permite .toFixed(2))
  qtUnidade     Int      @default(0) @map("qt_unidade")
  subtotal      Float    @default(0) // Compatibilidade direta com formulário LanchesForm.tsx
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relacionamentos
  itensPedido ItemPedidoLanche[]

  @@map("lanches")
}

/// Pedidos de Compra
/// Compatível com a interface Pedido em src/types/index.ts
model Pedido {
  id         Int          @id @default(autoincrement())
  qtInteira  Int          @default(0) @map("qt_inteira")
  qtMeia     Int          @default(0) @map("qt_meia")
  valorTotal Float        @map("valor_total") // Float serializa como number
  status     StatusPedido @default(CONCLUIDO)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  // Relacionamentos
  ingressos Ingresso[]
  lanches   ItemPedidoLanche[]
  usuarioId Int?               @map("usuario_id")
  usuario   Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@map("pedidos")
}

/// Ingressos Emitidos
/// Compatível com a interface Ingresso em src/types/index.ts
model Ingresso {
  id        Int          @id @default(autoincrement())
  sessaoId  Int          @map("sessao_id")
  pedidoId  Int?         @map("pedido_id")
  tipo      TipoIngresso @default(inteira) // 'inteira' | 'meia' exatamente como no frontend
  valor     Float // Float serializa como number
  assento   String? // Opcional para seleção de assento futura
  createdAt DateTime     @default(now()) @map("created_at")

  // Relacionamentos
  sessao Sessao  @relation(fields: [sessaoId], references: [id], onDelete: Restrict)
  pedido Pedido? @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@unique([sessaoId, assento])
  @@index([sessaoId])
  @@index([pedidoId])
  @@map("ingressos")
}

/// Itens de Lanche comprados no Pedido (Normalização 3FN)
model ItemPedidoLanche {
  id            Int      @id @default(autoincrement())
  pedidoId      Int      @map("pedido_id")
  lancheId      Int      @map("lanche_id")
  quantidade    Int      @default(1)
  valorUnitario Float    @map("valor_unitario")
  subtotal      Float
  createdAt     DateTime @default(now()) @map("created_at")

  // Relacionamentos
  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  lanche Lanche @relation(fields: [lancheId], references: [id], onDelete: Restrict)

  @@index([pedidoId])
  @@index([lancheId])
  @@map("itens_pedido_lanche")
}

/// Usuários do Sistema (Opcional, para autenticação e gestão de acessos)
model Usuario {
  id        Int          @id @default(autoincrement())
  nome      String
  email     String       @unique
  senha     String
  cargo     CargoUsuario @default(ATENDENTE)
  ativo     Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // Relacionamentos
  pedidos Pedido[]

  @@map("usuarios")
}
